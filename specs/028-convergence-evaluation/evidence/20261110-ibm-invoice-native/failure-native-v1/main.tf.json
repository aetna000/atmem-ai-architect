{
  "terraform": {
    "required_version": ">= 1.17.1, < 2.0.0",
    "required_providers": {
      "ibm": {
        "source": "IBM-Cloud/ibm",
        "version": "2.9.0"
      }
    }
  },
  "provider": {
    "ibm": {
      "region": "${var.region}"
    }
  },
  "variable": {
    "review_approved": {
      "type": "bool",
      "default": false
    },
    "applications_enabled": {
      "type": "bool",
      "default": false,
      "description": "Enable only after native SQL identity/schema/membership bootstrap, secret population and immutable image publication are reviewed."
    },
    "region": {
      "type": "string",
      "nullable": false,
      "description": "Reviewed single deployment/data region; verify current service/model availability and quotas.",
      "validation": {
        "condition": "${var.region == \"au-syd\"}",
        "error_message": "Placement is bound to this design. Update and regenerate the design before changing region."
      },
      "default": "au-syd"
    },
    "account_id": {
      "type": "string",
      "nullable": false,
      "description": "Expected existing IBM Cloud account. No account is created.",
      "validation": {
        "condition": "${can(regex(\"^[0-9a-f]{32}$\",var.account_id))}",
        "error_message": "Supply the reviewed account_id input."
      }
    },
    "resource_group_name": {
      "type": "string",
      "nullable": false,
      "description": "Existing reviewed destination resource group; never recreated.",
      "validation": {
        "condition": "${can(regex(\"^[A-Za-z0-9 _.-]{1,128}$\",var.resource_group_name))}",
        "error_message": "Supply the reviewed resource_group_name input."
      }
    },
    "model_id": {
      "type": "string",
      "nullable": false,
      "description": "Reviewed regional watsonx JSON-object model; verify lifecycle, regional availability and processing terms.",
      "validation": {
        "condition": "${can(regex(\"^[a-z0-9][a-z0-9_.-]{0,79}/[a-z0-9][a-z0-9_.-]{0,99}$\",var.model_id))}",
        "error_message": "Supply the reviewed model_id input."
      }
    },
    "watsonx_project_id": {
      "type": "string",
      "nullable": false,
      "description": "Existing watsonx project; authorize only the worker trusted profile and associate its runtime instance.",
      "validation": {
        "condition": "${can(regex(\"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$\",var.watsonx_project_id))}",
        "error_message": "Supply the reviewed watsonx_project_id input."
      }
    },
    "runtime_instance_id": {
      "type": "string",
      "nullable": false,
      "description": "Existing associated watsonx.ai Runtime instance GUID, not a deployment ID.",
      "validation": {
        "condition": "${can(regex(\"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$\",var.runtime_instance_id))}",
        "error_message": "Supply the reviewed runtime_instance_id input."
      }
    },
    "accounting_endpoint": {
      "type": "string",
      "nullable": false,
      "description": "Existing reviewed accounting HTTPS adapter; never provision a replacement.",
      "validation": {
        "condition": "${can(regex(\"^https://[A-Za-z0-9.-]+(:[0-9]{1,5})?(/[^?#@ ]*)?$\",var.accounting_endpoint))}",
        "error_message": "Supply the reviewed accounting_endpoint input."
      }
    },
    "accounting_scope": {
      "type": "string",
      "nullable": false,
      "description": "Reviewed accounting scope bound to each approval.",
      "validation": {
        "condition": "${can(regex(\"^[A-Za-z0-9_.:/-]{1,200}$\",var.accounting_scope))}",
        "error_message": "Supply the reviewed accounting_scope input."
      }
    },
    "registry_pull_secret": {
      "type": "string",
      "nullable": false,
      "description": "Name of the separately populated registry-pull secret in the new owned Code Engine project. No credential in Terraform.",
      "validation": {
        "condition": "${can(regex(\"^[a-z][a-z0-9-]{1,61}[a-z0-9]$\",var.registry_pull_secret))}",
        "error_message": "Supply the reviewed registry_pull_secret input."
      }
    },
    "runtime_image": {
      "type": "string",
      "nullable": false,
      "description": "Reviewed immutable image in this package-owned regional registry namespace. Empty during foundation.",
      "validation": {
        "condition": "${!var.applications_enabled || can(regex(\"@sha256:[0-9a-f]{64}$\",var.runtime_image))}",
        "error_message": "Use the reviewed immutable image digest before releasing applications."
      },
      "default": ""
    },
    "parser_image": {
      "type": "string",
      "nullable": false,
      "description": "Reviewed immutable image in this package-owned regional registry namespace. Empty during foundation.",
      "validation": {
        "condition": "${!var.applications_enabled || can(regex(\"@sha256:[0-9a-f]{64}$\",var.parser_image))}",
        "error_message": "Use the reviewed immutable image digest before releasing applications."
      },
      "default": ""
    },
    "staff_subjects": {
      "type": "set(string)",
      "default": [],
      "description": "Explicit existing admin-enrolled App ID subjects. Application membership/reviewer grants are separately admitted in SQL.",
      "validation": {
        "condition": "${alltrue([for subject in var.staff_subjects : can(regex(\"^[A-Za-z0-9_.:@-]{1,200}$\",subject))])}",
        "error_message": "Use exact verified staff subjects, never public signup or display-name guesses."
      }
    },
    "policy_review_base64": {
      "type": "string",
      "default": "",
      "description": "Scoped expiring model privacy/processing-terms review. Empty blocks inference; no approval is fabricated."
    },
    "replay_review_base64": {
      "type": "string",
      "default": "",
      "description": "Scoped expiring acceptance of actual accounting idempotency. Empty disables automatic uncertain replay."
    }
  },
  "locals": {
    "name": "${format(\"invoice-%s\",substr(sha256(\"https://atmem.ai/workspaces/11111111-1111-4111-8111-111111111111/block_696e766f696365/staging\"),0,12))}",
    "account_uuid": "11111111-1111-4111-8111-111111111111",
    "api_db_user": "${format(\"invoice_api_%s\",substr(sha256(\"https://atmem.ai/workspaces/11111111-1111-4111-8111-111111111111/block_696e766f696365/staging\"),0,12))}",
    "worker_db_user": "${format(\"invoice_worker_%s\",substr(sha256(\"https://atmem.ai/workspaces/11111111-1111-4111-8111-111111111111/block_696e766f696365/staging\"),0,12))}",
    "destination_contract": {
      "id": "normalized-action-v1",
      "endpointSha256": "${sha256(var.accounting_endpoint)}",
      "scope": "${var.accounting_scope}",
      "mappingVersion": 1
    },
    "destination_contract_base64": "${base64encode(jsonencode(local.destination_contract))}",
    "database_config_name": "${local.name}-database",
    "parser_secret_name": "${local.name}-parser",
    "api_secret_name": "${local.name}-api-sql",
    "worker_secret_name": "${local.name}-worker",
    "bucket_name": "${format(\"%s-%s\",local.name,substr(var.account_id,0,8))}"
  },
  "data": {
    "ibm_resource_group": {
      "destination": {
        "name": "${var.resource_group_name}"
      }
    }
  },
  "resource": {
    "terraform_data": {
      "review_gate": {
        "input": {
          "design_revision": 1,
          "environment": "staging",
          "provider": "ibm"
        },
        "lifecycle": {
          "precondition": [
            {
              "condition": "${var.review_approved}",
              "error_message": "Review the actual source, placement, identities, existing accounting contract, costs, operations and destination account before any apply."
            },
            {
              "condition": "${!var.applications_enabled || startswith(var.runtime_image,format(\"%s/%s/runtime@sha256:\",lookup({\"au-syd\":\"au.icr.io\",\"br-sao\":\"br.icr.io\",\"ca-mon\":\"ca2.icr.io\",\"ca-tor\":\"ca.icr.io\",\"eu-de\":\"de.icr.io\",\"eu-es\":\"es.icr.io\",\"eu-gb\":\"uk.icr.io\",\"in-che\":\"in.icr.io\",\"in-mum\":\"in2.icr.io\",\"jp-osa\":\"jp2.icr.io\",\"jp-tok\":\"jp.icr.io\",\"us-south\":\"us.icr.io\"},var.region),local.name))}",
              "error_message": "Images must use the exact owned regional registry namespace, not an invented hostname or foreign repository."
            },
            {
              "condition": "${!var.applications_enabled || startswith(var.parser_image,format(\"%s/%s/parser@sha256:\",lookup({\"au-syd\":\"au.icr.io\",\"br-sao\":\"br.icr.io\",\"ca-mon\":\"ca2.icr.io\",\"ca-tor\":\"ca.icr.io\",\"eu-de\":\"de.icr.io\",\"eu-es\":\"es.icr.io\",\"eu-gb\":\"uk.icr.io\",\"in-che\":\"in.icr.io\",\"in-mum\":\"in2.icr.io\",\"jp-osa\":\"jp2.icr.io\",\"jp-tok\":\"jp.icr.io\",\"us-south\":\"us.icr.io\"},var.region),local.name))}",
              "error_message": "Images must use the exact owned regional registry namespace, not an invented hostname or foreign repository."
            },
            {
              "condition": "${data.ibm_resource_group.destination.account_id == var.account_id && (!var.applications_enabled || length(var.staff_subjects)>0)}",
              "error_message": "Verify the destination account and explicit staff admission before release."
            }
          ]
        }
      }
    },
    "ibm_code_engine_project": {
      "block_696e766f696365": {
        "name": "${local.name}",
        "resource_group_id": "${data.ibm_resource_group.destination.id}",
        "lifecycle": {
          "prevent_destroy": true
        },
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "ibm_cr_namespace": {
      "block_696e766f696365": {
        "name": "${local.name}",
        "resource_group_id": "${data.ibm_resource_group.destination.id}",
        "lifecycle": {
          "prevent_destroy": true
        },
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "ibm_database": {
      "block_696e766f696365": {
        "name": "${local.name}",
        "service": "databases-for-postgresql",
        "plan": "standard",
        "location": "${var.region}",
        "resource_group_id": "${data.ibm_resource_group.destination.id}",
        "version": "18",
        "service_endpoints": "private",
        "deletion_protection": true,
        "group": {
          "group_id": "member",
          "memory": {
            "allocation_mb": 2048
          },
          "disk": {
            "allocation_mb": 20480
          },
          "members": {
            "allocation_count": 2
          }
        },
        "configuration": "{\"log_statement\":\"none\",\"log_min_error_statement\":\"panic\",\"log_parameter_max_length_on_error\":0}",
        "lifecycle": {
          "prevent_destroy": true
        },
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "ibm_resource_instance": {
      "block_696e766f696365_documents": {
        "name": "${local.name}-documents",
        "service": "cloud-object-storage",
        "plan": "standard",
        "location": "global",
        "resource_group_id": "${data.ibm_resource_group.destination.id}",
        "lifecycle": {
          "prevent_destroy": true
        },
        "depends_on": [
          "terraform_data.review_gate"
        ]
      },
      "block_696e766f696365_identity": {
        "name": "${local.name}-staff",
        "service": "appid",
        "plan": "graduated-tier",
        "location": "${var.region}",
        "resource_group_id": "${data.ibm_resource_group.destination.id}",
        "lifecycle": {
          "prevent_destroy": true
        },
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "ibm_cos_bucket": {
      "block_696e766f696365": {
        "bucket_name": "${local.bucket_name}",
        "resource_instance_id": "${ibm_resource_instance.block_696e766f696365_documents.id}",
        "region_location": "${var.region}",
        "storage_class": "standard",
        "endpoint_type": "public",
        "force_delete": false,
        "object_versioning": {
          "enable": true
        },
        "lifecycle": {
          "prevent_destroy": true
        },
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "ibm_cos_bucket_lifecycle_configuration": {
      "block_696e766f696365": {
        "bucket_crn": "${ibm_cos_bucket.block_696e766f696365.crn}",
        "bucket_location": "${var.region}",
        "endpoint_type": "public",
        "lifecycle_rule": [
          {
            "rule_id": "invoice-originals-90-days",
            "status": "Enabled",
            "filter": {
              "prefix": "accounts/"
            },
            "expiration": {
              "days": 90
            },
            "noncurrent_version_expiration": {
              "noncurrent_days": 1
            }
          },
          {
            "rule_id": "unfinished-upload-cleanup",
            "status": "Enabled",
            "filter": {
              "prefix": "accounts/"
            },
            "abort_incomplete_multipart_upload": {
              "days_after_initiation": 1
            }
          }
        ],
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "ibm_iam_trusted_profile": {
      "block_696e766f696365_api": {
        "name": "${local.name}-api",
        "description": "Dedicated invoice api; SQL login and business membership are independent.",
        "depends_on": [
          "terraform_data.review_gate"
        ]
      },
      "block_696e766f696365_worker": {
        "name": "${local.name}-worker",
        "description": "Dedicated invoice worker; SQL login and business membership are independent.",
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "ibm_iam_trusted_profile_link": {
      "block_696e766f696365_api": {
        "count": "${var.applications_enabled ? 1 : 0}",
        "profile_id": "${ibm_iam_trusted_profile.block_696e766f696365_api.profile_id}",
        "cr_type": "CE",
        "link": {
          "crn": "${ibm_code_engine_project.block_696e766f696365.crn}",
          "component_name": "${local.name}-api",
          "component_type": "app"
        },
        "depends_on": [
          "terraform_data.review_gate",
          "ibm_code_engine_app.block_696e766f696365_api"
        ]
      },
      "block_696e766f696365_worker": {
        "count": "${var.applications_enabled ? 1 : 0}",
        "profile_id": "${ibm_iam_trusted_profile.block_696e766f696365_worker.profile_id}",
        "cr_type": "CE",
        "link": {
          "crn": "${ibm_code_engine_project.block_696e766f696365.crn}",
          "component_name": "${local.name}-worker",
          "component_type": "app"
        },
        "depends_on": [
          "terraform_data.review_gate",
          "ibm_code_engine_app.block_696e766f696365_worker"
        ]
      }
    },
    "ibm_iam_trusted_profile_policy": {
      "block_696e766f696365_api_documents": {
        "iam_id": "${ibm_iam_trusted_profile.block_696e766f696365_api.iam_id}",
        "roles": [
          "Object Reader",
          "Object Writer"
        ],
        "resources": {
          "service": "cloud-object-storage",
          "resource_instance_id": "${ibm_resource_instance.block_696e766f696365_documents.guid}",
          "resource_type": "bucket",
          "resource": "${local.bucket_name}"
        },
        "depends_on": [
          "terraform_data.review_gate"
        ]
      },
      "block_696e766f696365_worker_documents": {
        "iam_id": "${ibm_iam_trusted_profile.block_696e766f696365_worker.iam_id}",
        "roles": [
          "Object Reader"
        ],
        "resources": {
          "service": "cloud-object-storage",
          "resource_instance_id": "${ibm_resource_instance.block_696e766f696365_documents.guid}",
          "resource_type": "bucket",
          "resource": "${local.bucket_name}"
        },
        "depends_on": [
          "terraform_data.review_gate"
        ]
      },
      "block_696e766f696365_model": {
        "iam_id": "${ibm_iam_trusted_profile.block_696e766f696365_worker.iam_id}",
        "roles": [
          "Writer"
        ],
        "resources": {
          "service": "pm-20",
          "resource_instance_id": "${var.runtime_instance_id}",
          "region": "${var.region}"
        },
        "description": "Instance-scoped native watsonx role. Writer is broader than prediction-only; separate project collaborator admission remains required.",
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "ibm_appid_application": {
      "block_696e766f696365": {
        "tenant_id": "${ibm_resource_instance.block_696e766f696365_identity.guid}",
        "name": "${local.name}",
        "type": "singlepageapp",
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "ibm_appid_application_scopes": {
      "block_696e766f696365": {
        "tenant_id": "${ibm_resource_instance.block_696e766f696365_identity.guid}",
        "client_id": "${ibm_appid_application.block_696e766f696365.client_id}",
        "scopes": [
          "process"
        ],
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "ibm_appid_role": {
      "block_696e766f696365": {
        "tenant_id": "${ibm_resource_instance.block_696e766f696365_identity.guid}",
        "name": "InvoiceStaff",
        "access": [
          {
            "application_id": "${ibm_appid_application.block_696e766f696365.client_id}",
            "scopes": [
              "process"
            ]
          }
        ],
        "depends_on": [
          "terraform_data.review_gate",
          "ibm_appid_application_scopes.block_696e766f696365"
        ]
      }
    },
    "ibm_appid_user_roles": {
      "block_696e766f696365": {
        "for_each": "${var.applications_enabled ? var.staff_subjects : toset([])}",
        "tenant_id": "${ibm_resource_instance.block_696e766f696365_identity.guid}",
        "subject": "${each.value}",
        "role_ids": [
          "${ibm_appid_role.block_696e766f696365.role_id}"
        ],
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "ibm_appid_idp_cloud_directory": {
      "block_696e766f696365": {
        "tenant_id": "${ibm_resource_instance.block_696e766f696365_identity.guid}",
        "is_active": true,
        "signup_enabled": false,
        "self_service_enabled": false,
        "welcome_enabled": false,
        "reset_password_enabled": true,
        "reset_password_notification_enabled": true,
        "identity_field": "email",
        "identity_confirm_access_mode": "FULL",
        "identity_confirm_methods": [
          "email"
        ],
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "ibm_appid_idp_google": {
      "block_696e766f696365": {
        "tenant_id": "${ibm_resource_instance.block_696e766f696365_identity.guid}",
        "is_active": false,
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "ibm_appid_idp_facebook": {
      "block_696e766f696365": {
        "tenant_id": "${ibm_resource_instance.block_696e766f696365_identity.guid}",
        "is_active": false,
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "ibm_appid_idp_saml": {
      "block_696e766f696365": {
        "tenant_id": "${ibm_resource_instance.block_696e766f696365_identity.guid}",
        "is_active": false,
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "ibm_code_engine_app": {
      "block_696e766f696365_api": {
        "count": "${var.applications_enabled ? 1 : 0}",
        "project_id": "${ibm_code_engine_project.block_696e766f696365.project_id}",
        "name": "${local.name}-api",
        "image_reference": "${var.runtime_image}",
        "image_secret": "${var.registry_pull_secret}",
        "image_port": 8080,
        "managed_domain_mappings": "local_public",
        "run_as_user": 10001,
        "run_service_account": "none",
        "run_compute_resource_token_enabled": true,
        "scale_cpu_limit": "1",
        "scale_memory_limit": "1G",
        "scale_min_instances": 1,
        "scale_max_instances": 1,
        "scale_concurrency": 32,
        "scale_concurrency_target": 16,
        "scale_request_timeout": 300,
        "run_env_variables": [
          {
            "name": "ACCOUNT_ID",
            "value": "${local.account_uuid}",
            "type": "literal"
          },
          {
            "name": "REGION",
            "value": "${var.region}",
            "type": "literal"
          },
          {
            "name": "WORKFLOW_NAMESPACE",
            "value": "invoice",
            "type": "literal"
          },
          {
            "name": "DATABASE_NAME",
            "value": "ibmclouddb",
            "type": "literal"
          },
          {
            "name": "DOCUMENT_BUCKET",
            "value": "${local.bucket_name}",
            "type": "literal"
          },
          {
            "name": "DESTINATION_CONTRACT_BASE64",
            "value": "${local.destination_contract_base64}",
            "type": "literal"
          },
          {
            "name": "SERVICE_NAME",
            "value": "${local.name}-api",
            "type": "literal"
          },
          {
            "name": "PUBLIC_ORIGIN_MODE",
            "value": "code-engine-default",
            "type": "literal"
          },
          {
            "name": "DATABASE_USER",
            "value": "${local.api_db_user}",
            "type": "literal"
          },
          {
            "name": "IAM_PROFILE_ID",
            "value": "${ibm_iam_trusted_profile.block_696e766f696365_api.profile_id}",
            "type": "literal"
          },
          {
            "name": "APPID_TENANT_ID",
            "value": "${ibm_resource_instance.block_696e766f696365_identity.guid}",
            "type": "literal"
          },
          {
            "name": "APPID_CLIENT_ID",
            "value": "${ibm_appid_application.block_696e766f696365.client_id}",
            "type": "literal"
          },
          {
            "name": "APPID_ISSUER",
            "value": "${ibm_appid_application.block_696e766f696365.oauth_server_url}",
            "type": "literal"
          },
          {
            "name": "AUTH_SCOPE",
            "value": "${local.name}/process",
            "type": "literal"
          },
          {
            "name": "DATABASE_HOST",
            "type": "config_map_key_reference",
            "key": "host",
            "reference": "${local.database_config_name}"
          },
          {
            "name": "DATABASE_PORT",
            "type": "config_map_key_reference",
            "key": "port",
            "reference": "${local.database_config_name}"
          },
          {
            "name": "DATABASE_CA_PEM",
            "type": "config_map_key_reference",
            "key": "ca_pem",
            "reference": "${local.database_config_name}"
          },
          {
            "name": "DATABASE_PASSWORD",
            "type": "secret_key_reference",
            "key": "password",
            "reference": "${local.api_secret_name}"
          }
        ],

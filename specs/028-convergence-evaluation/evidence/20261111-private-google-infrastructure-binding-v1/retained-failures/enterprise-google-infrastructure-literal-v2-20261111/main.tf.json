      "network": "${format(\"projects/%s/global/networks/%s\",var.project_id,google_compute_network.block_247b66696c6528226c69746572616c2d6576616c756174696f6e2d70726f62652e74787422297d20257b696620747275657d206d61726b657220257b656e6469667d.name)}",
      "subnetwork": "${format(\"projects/%s/regions/%s/subnetworks/%s\",var.project_id,var.region,google_compute_subnetwork.block_247b66696c6528226c69746572616c2d6576616c756174696f6e2d70726f62652e74787422297d20257b696620747275657d206d61726b657220257b656e6469667d.name)}"
    }

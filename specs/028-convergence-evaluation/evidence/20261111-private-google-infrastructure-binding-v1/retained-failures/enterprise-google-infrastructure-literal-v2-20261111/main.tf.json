        "input": {
          "design_revision": 7,
          "environment": "qualification",
          "source_component": "${file(\"literal-evaluation-probe.txt\")} %{if true} marker %{endif}"
        },
        "lifecycle": {
          "precondition": [
            {
              "condition": "${var.review_approved}",
              "error_message": "Review the destination and complete this component plan before any apply."
            },
            {
              "condition": "${endswith(var.worker_service_account,format(\"@%s.iam.gserviceaccount.com\",var.project_id))}",
              "error_message": "The existing worker identity must belong to this destination project."
            },
            {
              "condition": "${var.worker_service_account != format(\"%s-vm@%s.iam.gserviceaccount.com\",local.name,var.project_id)}",
              "error_message": "Keep question-worker and parser-transfer VM identities separate."
            },
            {
              "condition": "${!var.images_ready || startswith(var.parser_image,format(\"%s-docker.pkg.dev/%s/%s/parser@sha256:\",var.region,var.project_id,local.name))}",
              "error_message": "Keep parser in the owned regional registry with a reviewed digest."
            },
            {
              "condition": "${!var.images_ready || startswith(var.transfer_image,format(\"%s-docker.pkg.dev/%s/%s/transfer@sha256:\",var.region,var.project_id,local.name))}",
              "error_message": "Keep transfer in the owned regional registry with a reviewed digest."
            }
          ]
        }
      }
    },

{
  "terraform": {
    "required_version": ">= 1.17.1, < 2.0.0",
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": "7.46.2"
      },
      "google-beta": {
        "source": "hashicorp/google-beta",
        "version": "7.46.2"
      }
    }
  },
  "provider": {
    "google": {
      "project": "${var.project_id}",
      "region": "${var.region}"
    },
    "google-beta": {
      "project": "${var.project_id}",
      "region": "${var.region}"
    }
  },
  "variable": {
    "review_approved": {
      "type": "bool",
      "default": false,
      "nullable": false,
      "description": "Review the exact destination, IAM scope, raw-data retention, costs and operating responsibilities before any apply."
    },
    "images_ready": {
      "type": "bool",
      "default": false,
      "nullable": false,
      "description": "Enable configuration output only after actual immutable parser/transfer artifacts are built and reviewed."
    },
    "project_id": {
      "type": "string",
      "nullable": false,
      "description": "Existing owned project in which this package administers Batch jobs. Review project-scoped control permissions; unrelated workloads are not adopted.",
      "validation": {
        "condition": "${can(regex(\"^[a-z][a-z0-9-]{4,28}[a-z0-9]$\",var.project_id))}",
        "error_message": "Supply the reviewed project_id destination input."
      }
    },
    "region": {
      "type": "string",
      "nullable": false,
      "description": "Placement is bound to the selected architecture; regenerate to change it.",
      "validation": {
        "condition": "${can(regex(\"^australia-southeast1$\",var.region))}",
        "error_message": "Supply the reviewed region destination input."
      },
      "default": "australia-southeast1"
    },
    "worker_service_account": {
      "type": "string",
      "nullable": false,
      "description": "Existing question-worker service account in this project, referenced without changing its other roles or SQL identity.",
      "validation": {
        "condition": "${can(regex(\"^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]{4,28}[a-z0-9][.]iam[.]gserviceaccount[.]com$\",var.worker_service_account))}",
        "error_message": "Supply the reviewed worker_service_account destination input."
      }
    },
    "parser_image": {
      "type": "string",
      "default": "",
      "nullable": false,
      "description": "Immutable package-owned regional parser artifact; empty only during foundation.",
      "validation": {
        "condition": "${!var.images_ready || can(regex(\"^[a-z0-9./_-]+@sha256:[0-9a-f]{64}$\",var.parser_image))}",
        "error_message": "Use the actual reviewed immutable parser artifact."
      }
    },
    "transfer_image": {
      "type": "string",
      "default": "",
      "nullable": false,
      "description": "Immutable package-owned regional transfer artifact; empty only during foundation.",
      "validation": {
        "condition": "${!var.images_ready || can(regex(\"^[a-z0-9./_-]+@sha256:[0-9a-f]{64}$\",var.transfer_image))}",
        "error_message": "Use the actual reviewed immutable transfer artifact."
      }
    },
    "parser_revision": {
      "type": "string",
      "default": "",
      "nullable": false,
      "description": "Full independently qualified parser artifact revision, supplied by the image build receipt, not guessed from a source revision.",
      "validation": {
        "condition": "${!var.images_ready || can(regex(\"^[0-9a-f]{64}$\",var.parser_revision))}",
        "error_message": "Supply the actual qualified parser artifact revision."
      }
    }
  },
  "locals": {
    "name": "${format(\"doc-%s\",substr(sha256(\"https://atmem.ai/workspaces/private-knowledge-qualification/block_247b66696c6528226c69746572616c2d6576616c756174696f6e2d70726f62652e74787422297d20257b696620747275657d206d61726b657220257b656e6469667d/qualification\"),0,12))}",
    "document_job_configuration": {
      "format": "enterprise-google-document-job-v1",
      "projectId": "${var.project_id}",
      "region": "${var.region}",

resource.type="cloud_run_job" AND resource.labels.location="${var.region}" AND (resource.labels.job_name="${local.name}-initialize" OR resource.labels.job_name="${local.name}-maintain" OR resource.labels.job_name="${local.name}-monitor") AND ((jsonPayload.format="invoice-operator-v1" AND (jsonPayload.status="failed" OR jsonPayload.status="attention" OR jsonPayload.status="backlog")) OR severity>=ERROR)

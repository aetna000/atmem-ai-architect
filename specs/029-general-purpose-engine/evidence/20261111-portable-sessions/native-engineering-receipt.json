      "sha256": "ee541d089d117daa5f644fd218db97479268718b63ac8de494b935f1f93d3b1a",
      "text": "\"\"\"Tests for capacity reservations.\"\"\"\n\nimport unittest\n\nfrom reservations import release, reserve\n\n\nclass ReserveTests(unittest.TestCase):\n    def test_success(self):\n        self.assertEqual(reserve(10, 3, 4), 7)\n        self.assertEqual(reserve(10, 0, 3), 3)\n        self.assertEqual(reserve(10, 3, 0), 3)\n\n    def test_full_capacity(self):\n        self.assertEqual(reserve(10, 3, 7), 10)\n        self.assertEqual(reserve(10, 10, 0), 10)\n        self.assertEqual(reserve(0, 0, 0), 0)\n\n    def test_invalid_input(self):\n        invalid_values = (-1, True, False, 1.0, \"1\", None, [], {}, 1j)\n        for position in range(3):\n            for value in invalid_values:\n                arguments = [10, 2, 3]\n                arguments[position] = value\n                with self.subTest(position=position, value=value):\n                    with self.assertRaises(ValueError):\n                        reserve(*arguments)\n\n    def test_over_capacity(self):\n        for arguments in ((10, 7, 4), (10, 11, 0), (0, 0, 1)):\n            with self.subTest(arguments=arguments):\n                with self.assertRaises(ValueError):\n                    reserve(*arguments)\n\n\nclass ReleaseTests(unittest.TestCase):\n    def test_success(self):\n        self.assertEqual(release(10, 3), 7)\n\n    def test_zero_release(self):\n        self.assertEqual(release(10, 0), 10)\n        self.assertEqual(release(0, 0), 0)\n\n    def test_release_all(self):\n        self.assertEqual(release(10, 10), 0)\n\n    def test_invalid_input(self):\n        invalid_values = (-1, True, False, 1.0, \"1\", None, [], {}, 1j)\n        for position in range(2):\n            for value in invalid_values:\n                arguments = [10, 3]\n                arguments[position] = value\n                with self.subTest(position=position, value=value):\n                    with self.assertRaises(ValueError):\n                        release(*arguments)\n\n    def test_release_exceeds_booked(self):\n        for arguments in ((10, 11), (0, 1)):\n            with self.subTest(arguments=arguments):\n                with self.assertRaises(ValueError):\n                    release(*arguments)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"
    },
    "reservations.py": {
      "sha256": "27550ecdda7c292cd48ce4375fdc2e45001e5bae16d300c9eecf7841b789880b",
      "text": "\"\"\"Validate and reserve capacity.\"\"\"\n\n\ndef reserve(capacity, booked, requested):\n    \"\"\"Return the new booked count, or raise ValueError for invalid input.\"\"\"\n    for value in (capacity, booked, requested):\n        if isinstance(value, bool) or not isinstance(value, int) or value < 0:\n            raise ValueError(\"Arguments must be nonnegative integers\")\n\n    total = booked + requested\n    if total > capacity:\n        raise ValueError(\"Reservation exceeds capacity\")\n    return total\n\n\ndef release(booked, count):\n    \"\"\"Return the remaining booked count, or raise ValueError for invalid input.\"\"\"\n    for value in (booked, count):\n        if isinstance(value, bool) or not isinstance(value, int) or value < 0:\n            raise ValueError(\"Arguments must be nonnegative integers\")\n\n    if count > booked:\n        raise ValueError(\"Release exceeds booked count\")\n    return booked - count\n"
    }
  },

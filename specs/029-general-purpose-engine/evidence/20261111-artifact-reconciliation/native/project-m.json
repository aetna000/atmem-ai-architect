  "discovery": {
    "problem": "An independent local reading converter. Keep the existing rain gauge and unrelated archive catalogue unchanged."
  },
  "requirements": [
    {
      "id": "conversion",
      "kind": "functional",
      "category": "other",
      "statement": "Provide independent CommonJS readings.cjs exporting normalize(millimetres) and unit. Accept every finite nonnegative number primitive, reject all other values with TypeError, and return rainfall in metres (divide by1000). Export unit as m. Preserve the client-owned rain gauge and archive catalogue. Keep Unicode labels such as 🛰️ in documentation. No network or cloud dependencies.",
      "priority": "must",
      "status": "open",
      "source": "user",
      "links": [
        "viewer"
      ],
      "basis": "Edited by the user in block review; implementation must be re-evaluated."
    },
    {
      "id": "archive",
      "kind": "functional",
      "category": "other",
      "statement": "Preserve the existing archive catalogue without changing its implementation or ownership.",
      "priority": "must",
      "status": "open",
      "source": "user",
      "links": [
        "archive"
      ]
    }
  ],

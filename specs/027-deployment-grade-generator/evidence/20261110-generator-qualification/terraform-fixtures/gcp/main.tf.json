{
  "terraform": {
    "required_version": ">= 1.7.0, < 2.0.0",
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": "7.46.2"
      }
    }
  },
  "provider": {
    "google": {
      "region": "${var.region}",
      "project": "${var.project_id}"
    }
  },
  "variable": {
    "review_approved": {
      "type": "bool",
      "default": false
    },
    "region": {
      "type": "string",
      "nullable": false,
      "description": "Explicitly reviewed provider region; no default destination."
    },
    "project_id": {
      "type": "string",
      "nullable": false,
      "description": "Existing destination Google Cloud project.",
      "validation": {
        "condition": "${length(trimspace(var.project_id)) > 0}",
        "error_message": "Supply a reviewed nonempty value."
      }
    },
    "block_736572766963652f6e65772d7632_name": {
      "type": "string",
      "nullable": false,
      "description": "Reviewed unique deployment name; application source is supplied separately.",
      "validation": {
        "condition": "${can(regex(\"^[a-z][a-z0-9-]{4,28}[a-z0-9]$\", var.block_736572766963652f6e65772d7632_name))}",
        "error_message": "Use a unique lowercase name of 6–30 letters, digits or hyphens, starting with a letter."
      }
    },
    "block_736572766963652f6e65772d7632_image": {
      "type": "string",
      "nullable": false,
      "description": "Reviewed immutable Linux container image digest. No model-generated application code is implied.",
      "validation": {
        "condition": "${can(regex(\"@sha256:[0-9a-f]{64}$\", var.block_736572766963652f6e65772d7632_image))}",
        "error_message": "Pin the reviewed application image with its SHA-256 digest."
      }
    }
  },
  "locals": {
    "unfinished_work": []
  },
  "resource": {
    "terraform_data": {
      "review_gate": {
        "input": {
          "design_revision": 2,
          "environment": "staging"
        },
        "lifecycle": {
          "precondition": [
            {
              "condition": "${var.review_approved && length(local.unfinished_work) == 0}",
              "error_message": "Review inputs and resolve all required implementations before applying."
            }
          ]
        }
      }
    },
    "google_service_account": {
      "block_736572766963652f6e65772d7632": {
        "account_id": "${var.block_736572766963652f6e65772d7632_name}",
        "display_name": "Application runtime identity",
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    },
    "google_cloud_run_v2_service": {
      "block_736572766963652f6e65772d7632": {
        "name": "${var.block_736572766963652f6e65772d7632_name}",
        "location": "${var.region}",
        "deletion_protection": true,
        "ingress": "INGRESS_TRAFFIC_INTERNAL_ONLY",
        "template": {
          "service_account": "${google_service_account.block_736572766963652f6e65772d7632.email}",
          "scaling": {
            "min_instance_count": 0,
            "max_instance_count": 2
          },
          "containers": {
            "image": "${var.block_736572766963652f6e65772d7632_image}",
            "ports": {
              "container_port": 8080
            },
            "resources": {
              "limits": {
                "cpu": "1",
                "memory": "512Mi"
              }
            },
            "startup_probe": {
              "tcp_socket": {
                "port": 8080
              }
            }
          }
        },
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    }
  },
  "output": {
    "block_736572766963652f6e65772d7632_uri": {
      "value": "${google_cloud_run_v2_service.block_736572766963652f6e65772d7632.uri}"
    }
  }
}
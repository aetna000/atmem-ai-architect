{
  "terraform": {
    "required_version": ">= 1.7.0, < 2.0.0",
    "required_providers": {
      "ibm": {
        "source": "IBM-Cloud/ibm",
        "version": "1.89.0"
      }
    }
  },
  "provider": {
    "ibm": {
      "region": "${var.region}"
    }
  },
  "variable": {
    "review_approved": {
      "type": "bool",
      "default": false
    },
    "region": {
      "type": "string",
      "nullable": false,
      "description": "Explicitly reviewed provider region; no default destination."
    },
    "block_736572766963652f6e65772d7632_name": {
      "type": "string",
      "nullable": false,
      "description": "Reviewed unique deployment name; application source is supplied separately.",
      "validation": {
        "condition": "${can(regex(\"^[a-z][a-z0-9-]{4,28}[a-z0-9]$\", var.block_736572766963652f6e65772d7632_name))}",
        "error_message": "Use a unique lowercase name of 6–30 letters, digits or hyphens, starting with a letter."
      }
    },
    "block_736572766963652f6e65772d7632_image": {
      "type": "string",
      "nullable": false,
      "description": "Reviewed immutable Linux container image digest. No model-generated application code is implied.",
      "validation": {
        "condition": "${can(regex(\"@sha256:[0-9a-f]{64}$\", var.block_736572766963652f6e65772d7632_image))}",
        "error_message": "Pin the reviewed application image with its SHA-256 digest."
      }
    },
    "code_engine_project_id": {
      "type": "string",
      "nullable": false,
      "description": "Existing reviewed Code Engine project ID.",
      "validation": {
        "condition": "${length(trimspace(var.code_engine_project_id)) > 0}",
        "error_message": "Supply a reviewed nonempty value."
      }
    }
  },
  "locals": {
    "unfinished_work": []
  },
  "resource": {
    "terraform_data": {
      "review_gate": {
        "input": {
          "design_revision": 2,
          "environment": "staging"
        },
        "lifecycle": {
          "precondition": [
            {
              "condition": "${var.review_approved && length(local.unfinished_work) == 0}",
              "error_message": "Review inputs and resolve all required implementations before applying."
            }
          ]
        }
      }
    },
    "ibm_code_engine_app": {
      "block_736572766963652f6e65772d7632": {
        "project_id": "${var.code_engine_project_id}",
        "name": "${var.block_736572766963652f6e65772d7632_name}",
        "image_reference": "${var.block_736572766963652f6e65772d7632_image}",
        "image_port": 8080,
        "managed_domain_mappings": "local",
        "run_service_account": "none",
        "scale_min_instances": 0,
        "scale_max_instances": 2,
        "scale_cpu_limit": "0.5",
        "scale_memory_limit": "1G",
        "lifecycle": {
          "prevent_destroy": true
        },
        "depends_on": [
          "terraform_data.review_gate"
        ]
      }
    }
  },
  "output": {
    "block_736572766963652f6e65772d7632_id": {
      "value": "${ibm_code_engine_app.block_736572766963652f6e65772d7632.id}"
    }
  }
}
  "requirementDrafts": [
    {
      "rationale": "Without this, SQS's at-least-once delivery could produce inconsistent or overwritten results.",
      "basis": "User: \"Duplicate deliveries must be safe\"",
      "id": "ai-idempotent-count",
      "statement": "Proposed: each object version produces exactly one stored word count, and a duplicate delivery succeeds without overwriting it.",
      "kind": "functional",
      "category": "reliability",
      "priority": "must",
      "links": [
        "worker",
        "results"
      ]
    },
    {
      "rationale": "Poison messages would otherwise loop forever or be silently lost.",
      "basis": "User: \"failures must retry, and poison messages must go to a dead-letter queue\"",
      "id": "ai-retry-dlq",
      "statement": "Proposed: failed messages are retried, then moved to a dead-letter queue after the maximum number of receives, with an alarm sent to an operator.",
      "kind": "nonfunctional",
      "category": "reliability",
      "priority": "must",
      "links": [
        "queue",
        "dlq"
      ]
    },
    {
      "rationale": "This avoids recording an unapproved region as a decision.",
      "basis": "User: \"Propose Sydney as a candidate region, but do not record that as an approved deployment region.\"",
      "id": "ai-region",
      "statement": "Proposed: the deployment region stays open; Sydney (ap-southeast-2) is a candidate only.",
      "kind": "nonfunctional",
      "category": "compliance",
      "priority": "should",
      "links": [
        "bucket",
        "queue",
        "worker",
        "results",
        "dlq"
      ]
    }
  ],

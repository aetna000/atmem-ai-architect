  "requirementDrafts": [
    {
      "rationale": "Without this, the assistant could reveal restricted content. The test servers do not prove native group expansion or inherited permissions, so production stays blocked until those are verified.",
      "basis": "User: \"Preserve source permissions, updates and deletes.\"",
      "id": "ai-permission-trimmed-answers",
      "statement": "Answers may use only documents the signed-in user is allowed to open, based on explicit ACLs copied from the source snapshot. Unknown identities or missing ACLs fail closed.",
      "kind": "nonfunctional",
      "category": "security",
      "priority": "must",
      "links": [
        "catalog",
        "rag-fn",
        "sp-src",
        "cf-src",
        "cognito"
      ]
    },
    {
      "rationale": "Stale or deleted documents could otherwise be cited. The checkpoint lets an interrupted sync resume without losing changes.",
      "basis": "User: \"Preserve source permissions, updates and deletes\" and \"include recovery and audit behavior\".",
      "id": "ai-source-change-sync",
      "statement": "Source updates and deletes reach the catalog through conditional writes and a recovery checkpoint, and revisions are rechecked before an answer is returned.",
      "kind": "functional",
      "category": "reliability",
      "priority": "must",
      "links": [
        "sp-src",
        "cf-src",
        "catalog",
        "rag-fn"
      ]
    },
    {
      "rationale": "An audit trail lets us show which sources supported an answer and investigate access questions. The retention period is still unknown.",
      "basis": "User: \"include recovery and audit behavior\".",
      "id": "ai-audit-trail",
      "statement": "Proposed: record who asked, which documents were cited and sync outcomes in logs with a retention period to be agreed.",
      "kind": "nonfunctional",
      "category": "compliance",
      "priority": "should",
      "links": [
        "rag-fn",
        "api",
        "sp-src",
        "cf-src"
      ]
    }
  ],

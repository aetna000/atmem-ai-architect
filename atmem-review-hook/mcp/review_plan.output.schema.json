{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atmem.ai/schemas/review_plan.output.v1.json",
  "title": "review_plan output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict",
    "summary",
    "violations",
    "cost",
    "risks",
    "suggested_fixes",
    "unverified",
    "reviewer"
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "artifact",
            "terraform_plan",
            "cost_engine",
            "rules"
          ]
        },
        "path": {
          "type": "string"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "excerpt": {
          "type": "string",
          "maxLength": 500,
          "description": "Verbatim text from the source."
        },
        "resource_address": {
          "type": "string",
          "description": "Terraform address, e.g. aws_db_instance.main"
        },
        "attribute": {
          "type": "string",
          "description": "e.g. publicly_accessible"
        },
        "value": {}
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "error",
        "warning",
        "info"
      ]
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "fail"
      ],
      "description": "fail if any error violation (or any warning when fail_on=warning); warn if warnings or must-rules unverifiable; else pass."
    },
    "summary": {
      "type": "string",
      "maxLength": 600
    },
    "rules_file": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "rule_count": {
          "type": "integer"
        },
        "adr_count": {
          "type": "integer"
        }
      }
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "severity",
          "title",
          "evidence",
          "explanation"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "description": "ID from architecture.md, e.g. NET-001 or ADR-0003."
          },
          "severity": {
            "$ref": "#/$defs/severity"
          },
          "title": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "explanation": {
            "type": "string"
          },
          "exception_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Set when an accepted exception in architecture.md downgrades this finding."
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "estimated",
            "skipped",
            "error"
          ]
        },
        "reason": {
          "type": "string",
          "description": "Why skipped/error, e.g. no_terraform_plan, cost_estimate_off, engine_unavailable."
        },
        "engine": {
          "type": "string",
          "description": "e.g. infracost <version>"
        },
        "currency": {
          "type": "string"
        },
        "monthly_total": {
          "type": "number"
        },
        "budget_monthly": {
          "type": [
            "number",
            "null"
          ]
        },
        "over_budget": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "usage_assumptions": {
          "type": "string",
          "description": "Usage-based resources (egress, requests) are priced at zero unless usage is provided."
        },
        "top_resources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resource_address",
              "monthly_cost"
            ],
            "properties": {
              "resource_address": {
                "type": "string"
              },
              "monthly_cost": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/$defs/severity"
          },
          "description": {
            "type": "string"
          },
          "related_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "suggested_fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "target",
          "change"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "target": {
            "type": "string",
            "description": "File or resource to change, e.g. plan.md or aws_db_instance.main"
          },
          "change": {
            "type": "string"
          },
          "patch": {
            "type": "string",
            "description": "Optional unified diff suggestion. Never applied by the tool."
          }
        }
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "reason"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
